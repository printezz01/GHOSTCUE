# ──────────────────────────────────────────────
# GhostCue Environment Variables
# Copy this file to .env and fill in your keys
# ──────────────────────────────────────────────

# Groq — used for LLM analysis and question generation (Whisper runs locally)
# Groq is OpenAI-compatible and has a free tier. Model: llama-3.3-70b-versatile
# Get your free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot — get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Twilio — WhatsApp Business API credentials
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
